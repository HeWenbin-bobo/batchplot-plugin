@echo off
rem ===========================================================================
rem BPPlot - full non-GUI regression (AutoCAD 2025 / net8)
rem
rem Runs every command that CAN be scripted, prints PASS/FAIL per item.
rem
rem Covers : BPSELFTEST / BPLOTAUTO x2 (engine release) / BP1 /
rem          BPLOTMERGE (merged PDF + bookmarks) / BPSPLIT / BPREV /
rem          golden page sizes
rem
rem Not covered (see test\gui\README.md and AGENTS.md pitfall #33):
rem          BPLOT dialog  - ShowModalDialog owns the main thread
rem          BPPREVIEW     - preview window needs a graphics session
rem          BPTEACH pick  - GetEntity cannot be fed points from a .scr
rem          BPL           - needs paper-space layouts with plot config,
rem                          repo has no such fixture
rem
rem Prereq : build_net8.cmd at repo root
rem Usage  : test\run_all_net8.cmd
rem Env    : ACAD_DIR (default D:\Program Files\Autodesk\AutoCAD 2025)
rem ===========================================================================
setlocal

set "ROOT=%~dp0.."
set "SRC=%ROOT%\build\bin\Release\net8.0-windows"
set "W=%~dp0_all"

if "%ACAD_DIR%"=="" set "ACAD_DIR=D:\Program Files\Autodesk\AutoCAD 2025"
set "ACC=%ACAD_DIR%\accoreconsole.exe"

if not exist "%ACC%" (
  echo FAIL: accoreconsole not found: %ACC%
  echo       set ACAD_DIR=^<AutoCAD install dir^> then retry
  exit /b 1
)
if not exist "%SRC%\BPPlot.dll" (
  echo FAIL: %SRC%\BPPlot.dll not found
  echo       run build_net8.cmd at repo root first
  exit /b 1
)

if exist "%W%" rmdir /s /q "%W%"
mkdir "%W%"
copy /y "%SRC%\*.dll" "%W%\" >nul
copy /y "%~dp0fixtures\content.dwg" "%W%\" >nul
copy /y "%~dp0fixtures\blk.dwg" "%W%\" >nul

rem accoreconsole wants forward slashes inside the script
set "P=%W:\=/%"

rem ---------------- Scenario A: content.dwg (3 frames with content) --------
rem Three ordering details, each one hangs or breaks the chain if wrong:
rem  1) USERS2 empty before netload, real value after (pitfall #27)
rem  2) GetSelection needs one more empty line to end, otherwise the next
rem     command line gets swallowed as selection input
rem  3) BPLOTAUTO twice: a second ePlotAlreadyStarted means the engine was
rem     never released (pitfall #30)
> "%W%\a.scr" echo (setvar "secureload" 0)
>>"%W%\a.scr" echo (setvar "filedia" 0)
>>"%W%\a.scr" echo (setvar "users2" "")
>>"%W%\a.scr" echo (command "_.netload" "%P%/BPPlot.dll")
>>"%W%\a.scr" echo BPSELFTEST
>>"%W%\a.scr" echo (setvar "users1" "100")
>>"%W%\a.scr" echo (setvar "users2" "%P%/outA")
>>"%W%\a.scr" echo BPLOTAUTO
>>"%W%\a.scr" echo BPLOTAUTO
>>"%W%\a.scr" echo BP1
>>"%W%\a.scr" echo ALL
>>"%W%\a.scr" echo.
>>"%W%\a.scr" echo BPLOTMERGE
>>"%W%\a.scr" echo 150
>>"%W%\a.scr" echo %P%/outM
>>"%W%\a.scr" echo ALL
>>"%W%\a.scr" echo.
>>"%W%\a.scr" echo _.quit _y

> "%W%\a.cmd" echo @echo off
>>"%W%\a.cmd" echo "%ACC%" /i "%W%\content.dwg" /s "%W%\a.scr" ^> "%W%\a.log" 2^>^&1

rem ---------------- Scenario B: blk.dwg (block frames + attribute tags) -----
rem Generated by test\gui\MkBlockDwg from a fresh Database; block name and
rem tags are deliberately non-Chinese (TITLEBLOCK_A3 / TUHAO / TUMING / BILI
rem / BANCI / RIQI). BPREV cannot guess them, it needs the learned config
rem that BPTEACH would have written -- so write that file directly.
rem This is the documented stand-in for "BPTEACH pick is unscriptable"
rem (AGENTS.md pitfall #33): it proves learned-config -> recognition works,
rem without proving the pick click itself.
rem Back up any real config first: this suite must not eat a user's learned
rem tags. Restored at the end (also on the failure path).
if not exist "%APPDATA%\BPPlot" mkdir "%APPDATA%\BPPlot"
if exist "%APPDATA%\BPPlot\config.json" copy /y "%APPDATA%\BPPlot\config.json" "%W%\config.backup.json" >nul
> "%APPDATA%\BPPlot\config.json" echo {
>>"%APPDATA%\BPPlot\config.json" echo   "frameBlocks": ["TITLEBLOCK_A3"],
>>"%APPDATA%\BPPlot\config.json" echo   "numberTags": ["TUHAO"],
>>"%APPDATA%\BPPlot\config.json" echo   "nameTags": ["TUMING"],
>>"%APPDATA%\BPPlot\config.json" echo   "scaleTags": ["BILI"],
>>"%APPDATA%\BPPlot\config.json" echo   "revTags": ["BANCI"],
>>"%APPDATA%\BPPlot\config.json" echo   "dateTags": ["RIQI"],
>>"%APPDATA%\BPPlot\config.json" echo   "minPolylineSide": 15000,
>>"%APPDATA%\BPPlot\config.json" echo   "fileTemplate": "DRW"
>>"%APPDATA%\BPPlot\config.json" echo }
> "%W%\b.scr" echo (setvar "secureload" 0)
>>"%W%\b.scr" echo (setvar "filedia" 0)
>>"%W%\b.scr" echo (setvar "users2" "")
>>"%W%\b.scr" echo (command "_.netload" "%P%/BPPlot.dll")
>>"%W%\b.scr" echo (setvar "users2" "%P%/outB")
>>"%W%\b.scr" echo BPSPLIT
>>"%W%\b.scr" echo ALL
>>"%W%\b.scr" echo.
>>"%W%\b.scr" echo BPREV
>>"%W%\b.scr" echo ALL
>>"%W%\b.scr" echo.
>>"%W%\b.scr" echo B
>>"%W%\b.scr" echo 2025.06.30
>>"%W%\b.scr" echo _.quit _y

> "%W%\b.cmd" echo @echo off
>>"%W%\b.cmd" echo "%ACC%" /i "%W%\blk.dwg" /s "%W%\b.scr" ^> "%W%\b.log" 2^>^&1

echo === Scenario A: content.dwg (3 frames, plot + merge) ===
pushd "%W%"
cmd /c a.cmd >nul 2>&1
echo === Scenario B: blk.dwg (block frames, split + rev/date) ===
cmd /c b.cmd >nul 2>&1
popd

rem restore the user's real config (if any) before reporting
if exist "%W%\config.backup.json" (
  copy /y "%W%\config.backup.json" "%APPDATA%\BPPlot\config.json" >nul
) else (
  del /q "%APPDATA%\BPPlot\config.json" 2>nul
)

echo.
python "%~dp0verify_all.py" "%W%"
if errorlevel 1 (
  echo.
  echo FAIL: some checks failed, logs in %W%
  exit /b 1
)
echo OK: all passed
exit /b 0
